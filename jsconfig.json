{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "bin",
    "src",
    "test",
    "types.d.ts",
    "node_modules/@flancer32/**/*.mjs",
    "node_modules/@flancer32/**/types.d.ts",
    "node_modules/@teqfw/**/*.mjs",
    "node_modules/@teqfw/**/types.d.ts"
  ]
}
